# =================================================================
# AI Healthcare Assistant - Environment Configuration Template
# =================================================================
# Copy this file to .env and configure the parameters for your environment.
# DO NOT commit real secrets, API keys, or private tokens into version control.

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=super_secret_healthcare_jwt_key_replace_in_production_min32chars
JWT_EXPIRES_IN=7d

# Database Configuration
# Local SQLite database path (or PostgreSQL connection string if in production)
DATABASE_URL=./data/healthcare.db

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# AI Provider Configuration
# Supported providers: "heuristic" (default offline/testing mode), "gemini", "openai"
AI_PROVIDER=heuristic

# Gemini API Key (Required only if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI API Key (Required only if AI_PROVIDER=openai)
OPENAI_API_KEY=

# AI Model Selection
CHAT_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004
VISION_MODEL=gemini-1.5-flash

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Emergency Notification (Optional Webhook / Email for Admin Triage Alerts)
EMERGENCY_ALERT_ENABLED=false
ADMIN_EMAIL=admin@healthcare.local
